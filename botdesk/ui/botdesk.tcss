#menu {
    width: 40;
    height: auto;
    margin: 1 2;
}

#status {
    margin: 0 2;
    height: 1;
}

.section {
    margin: 1 1 0 1;
    text-style: bold;
}

.hint {
    margin: 0 1;
    color: $text-muted;
}

.error {
    color: $error;
    height: auto;
}

.warning {
    color: $warning;
    margin: 1 0;
}

.heading {
    text-style: bold;
    margin-bottom: 1;
}

.auth-box {
    width: 70;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    border: round $primary;
}

.auth-box Input {
    margin-bottom: 1;
}

ModalScreen {
    align: center middle;
}

.dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.dialog.wide {
    width: 90;
}

.dialog-text {
    margin-bottom: 1;
}

.dialog TextArea {
    height: 10;
}

.buttons {
    height: auto;
    margin-top: 1;
}

.buttons Button {
    margin-right: 2;
}

#commands, #steps {
    height: 1fr;
    margin: 0 1;
}

#chats {
    height: 1fr;
    margin: 0 1;
}

#files {
    height: 1fr;
    margin: 0 1;
}

#answers {
    height: 1fr;
    margin: 0 1;
}

#details {
    height: 5;
    margin: 0 1;
}

#log {
    height: 1fr;
    margin: 0 1;
    border: round $primary;
}

#reply {
    margin: 0 1;
}

#settings {
    padding: 0 2;
}

#settings Label {
    margin-top: 1;
}

.row {
    height: auto;
}

.row Input {
    width: 1fr;
}
